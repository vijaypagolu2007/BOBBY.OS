rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Internal-only collections ────────────────────────────────────────────
    // gemini_rate_limits is written exclusively by the Cloud Function (Admin SDK).
    // No client — even an authenticated one — may read or write it.
    match /gemini_rate_limits/{uid} {
      allow read, write: if false;
    }

    // ── User data ────────────────────────────────────────────────────────────
    // Each user may only access their own document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default (Firestore's implicit default, made explicit)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
