rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User data ────────────────────────────────────────────────────────────
    // Each user may only access their own document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default (Firestore's implicit default, made explicit)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
