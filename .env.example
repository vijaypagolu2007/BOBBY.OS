VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Gemini AI runs through Firebase AI Logic (free Spark plan, no Cloud Functions).
# Setup: Firebase console > AI Logic > Get started > Gemini Developer API.
# App Check (reCAPTCHA Enterprise, aka Fraud Defense) protects it: create a score-based key at
# https://www.google.com/recaptcha/admin, register it in Firebase console > App Check under "Fraud Defense",
# then paste the site key here.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
# Local dev only: App Check > Apps > Manage debug tokens > Generate token
VITE_APPCHECK_DEBUG_TOKEN=

# Android only: put this in .env.android (gitignored), NOT .env, so it never
# reaches the hosted web build. Register it in Firebase console > App Check >
# Apps > (web app) > Manage debug tokens. Build with `npm run android`.
# VITE_APPCHECK_ANDROID_TOKEN=
