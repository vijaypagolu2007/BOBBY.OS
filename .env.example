VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Gemini AI — choose one:
# Production: deploy functions/index.js, then paste the geminiProxy URL here.
#   firebase functions:secrets:set GEMINI_API_KEY   (store key server-side)
#   firebase deploy --only functions
VITE_GEMINI_PROXY_URL=https://<region>-<project-id>.cloudfunctions.net/geminiProxy

# Dev-only fallback (key is bundled in JS — never deploy with this set!):
VITE_GEMINI_API_KEY=your_gemini_api_key
